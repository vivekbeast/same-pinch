NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:dev@localhost:5433/samepinch
SESSION_PEPPER=change-me-to-48-random-bytes-base64
DEVICE_PEPPER=change-me-to-48-random-bytes-base64
JOBS_SECRET=change-me-to-48-random-bytes-base64
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
DEMO_MODE=true
SENTRY_DSN=
# Optional: owner connection for migrations/seed when DATABASE_URL points at the least-privilege app_user.
# DATABASE_URL_OWNER=postgres://postgres:dev@localhost:5433/samepinch
# Only for `npm run db:roles` (creates app_user):
# APP_DB_PASSWORD=

# Where the web app lives (redirect target after Google sign-in). Defaults to the first ALLOWED_ORIGINS entry.
APP_ORIGIN=http://localhost:5173
# Google sign-in (OAuth "Web application" client). Leave empty to hide the option.
# Authorized JavaScript origin: http://localhost:5173   Authorized redirect URI: GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
